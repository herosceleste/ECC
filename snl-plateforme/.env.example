# Copier ce fichier en .env et remplacer chaque valeur « a-remplacer ».
# Ne jamais versionner le fichier .env.
#
# Pour générer une valeur aléatoire :   openssl rand -base64 32

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_PASSWORD=a-remplacer
SNL_APP_PASSWORD=a-remplacer

# --- Keycloak -----------------------------------------------------------------
KEYCLOAK_DB_PASSWORD=a-remplacer
KEYCLOAK_ADMIN_PASSWORD=a-remplacer
KEYCLOAK_ADMIN_CLIENT_ID=snl-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=a-remplacer
KEYCLOAK_REALM=snl
OIDC_AUDIENCE=snl-api
OIDC_ACR_SECOND_FACTEUR=mfa
# En développement, on peut désactiver l'exigence de second facteur le temps
# de configurer le flux d'authentification renforcée dans Keycloak.
EXIGER_SECOND_FACTEUR=false

# --- Stockage des documents (MinIO en local) ------------------------------------
S3_ACCESS_KEY=a-remplacer
S3_SECRET_KEY=a-remplacer-au-moins-8-caracteres
S3_BUCKET=documents
S3_REGION=fr-par

# --- Données sensibles --------------------------------------------------------
# 32 octets aléatoires encodés en base64 : openssl rand -base64 32
CLE_CHIFFREMENT_DONNEES=a-remplacer

# --- Web ----------------------------------------------------------------------
# 32 octets aléatoires encodés en base64 : chiffrent le cookie de session.
SECRET_SESSION=a-remplacer
URL_PUBLIQUE_WEB=http://localhost:3000
CORS_ORIGINES=http://localhost:3000
