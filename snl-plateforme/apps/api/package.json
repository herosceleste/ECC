{
  "name": "@snl/api",
  "private": true,
  "version": "0.1.0",
  "description": "API de la plateforme SNL : socle M0",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "association:creer": "node dist/scripts/creer-association.js",
    "purger": "node dist/scripts/purger.js",
    "demo:charger": "node dist/scripts/donnees-demo.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "@aws-sdk/s3-request-presigner": "3.1173.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@prisma/client": "6.19.3",
    "@snl/shared": "0.1.0",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "nodemailer": "10.6.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.11",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.13",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "@types/nodemailer": "8.0.2"
  }
}
