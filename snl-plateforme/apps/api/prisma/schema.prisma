// Schéma du socle M0 de la plateforme SNL.
//
// Règles communes :
// - toute table métier porte `tenant_id` (l'association racine) et est protégée
//   par une politique RLS PostgreSQL (migration 0002) ;
// - les entités du référentiel portent leur source (`source`, `source_ref`) ;
// - les suppressions de personnes sont d'abord logiques (`supprime_le`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeOrganisation {
  ASSOCIATION
  ANTENNE
  GROUPE_LOCAL
}

enum RoleMembre {
  LOCATAIRE
  DEMANDEUR
  BENEVOLE
  COORDINATEUR
  TRAVAILLEUR_SOCIAL
  GESTIONNAIRE
  ADMINISTRATEUR
  PARTENAIRE
}

enum StatutUtilisateur {
  INVITE
  ACTIF
  SUSPENDU
}

enum StatutLogement {
  DISPONIBLE
  OCCUPE
  EN_TRAVAUX
  HORS_PARC
}

enum StatutAnalyse {
  EN_ATTENTE
  SAIN
  INFECTE
}

enum ResultatAudit {
  SUCCES
  REFUS
  ERREUR
}

model Organisation {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  parentId   String?          @map("parent_id") @db.Uuid
  type       TypeOrganisation
  nom        String
  slug       String
  /// Chemin matérialisé « /<racine>/<antenne>/<groupe>/ » : un droit sur un
  /// chemin couvre tous les chemins qui le prolongent.
  chemin     String
  creeLe     DateTime         @default(now()) @map("cree_le")
  modifieLe  DateTime         @updatedAt @map("modifie_le")

  parent     Organisation?    @relation("Arborescence", fields: [parentId], references: [id])
  enfants    Organisation[]   @relation("Arborescence")
  adhesions  Adhesion[]
  modules    ActivationModule[]

  @@unique([tenantId, slug])
  @@index([tenantId, chemin])
  @@map("organisation")
}

/// Compte global : une même personne peut appartenir à plusieurs associations.
model Utilisateur {
  id                String            @id @default(uuid()) @db.Uuid
  sujetIdentite     String?           @unique @map("sujet_identite")
  email             String            @unique
  nomAffiche        String            @map("nom_affiche")
  statut            StatutUtilisateur @default(INVITE)
  derniereConnexion DateTime?         @map("derniere_connexion")
  creeLe            DateTime          @default(now()) @map("cree_le")
  modifieLe         DateTime          @updatedAt @map("modifie_le")

  adhesions         Adhesion[]

  @@map("utilisateur")
}

model Adhesion {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  utilisateurId  String       @map("utilisateur_id") @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  role           RoleMembre
  creeLe         DateTime     @default(now()) @map("cree_le")

  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, organisationId, role])
  @@index([tenantId, utilisateurId])
  @@map("adhesion")
}

model ActivationModule {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  codeModule     String       @map("code_module")
  active         Boolean
  modifieLe      DateTime     @updatedAt @map("modifie_le")

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, codeModule])
  @@map("activation_module")
}

model Immeuble {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  organisationId String     @map("organisation_id") @db.Uuid
  ligneAdresse   String     @map("ligne_adresse")
  codePostal     String     @map("code_postal")
  commune        String
  codeInsee      String?    @map("code_insee")
  latitude       Float?
  longitude      Float?
  identifiantBan String?    @map("identifiant_ban")
  source         String     @default("saisie")
  sourceRef      String?    @map("source_ref")
  creeLe         DateTime   @default(now()) @map("cree_le")
  modifieLe      DateTime   @updatedAt @map("modifie_le")

  logements      Logement[]

  @@index([tenantId, organisationId])
  @@map("immeuble")
}

model Logement {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  immeubleId     String?        @map("immeuble_id") @db.Uuid
  reference      String
  typologie      String
  surfaceM2      Decimal?       @map("surface_m2") @db.Decimal(7, 2)
  etage          Int?
  classeDpe      String?        @map("classe_dpe")
  statut         StatutLogement @default(DISPONIBLE)
  source         String         @default("saisie")
  sourceRef      String?        @map("source_ref")
  creeLe         DateTime       @default(now()) @map("cree_le")
  modifieLe      DateTime       @updatedAt @map("modifie_le")

  immeuble       Immeuble?      @relation(fields: [immeubleId], references: [id])
  interventions  Intervention[]
  entretiens     EntretienPeriodique[]

  @@unique([tenantId, reference])
  @@index([tenantId, organisationId])
  @@map("logement")
}

model Menage {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  organisationId String     @map("organisation_id") @db.Uuid
  libelle        String
  source         String     @default("saisie")
  sourceRef      String?    @map("source_ref")
  creeLe         DateTime   @default(now()) @map("cree_le")
  modifieLe      DateTime   @updatedAt @map("modifie_le")
  supprimeLe     DateTime?  @map("supprime_le")

  personnes      Personne[]

  @@index([tenantId, organisationId])
  @@map("menage")
}

model Personne {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  organisationId     String    @map("organisation_id") @db.Uuid
  menageId           String?   @map("menage_id") @db.Uuid
  nom                String
  prenom             String
  dateNaissance      DateTime? @map("date_naissance") @db.Date
  telephone          String?
  email              String?
  /// Champs normalisés servant à la détection des doublons (règle M0-R01).
  nomNormalise       String    @map("nom_normalise")
  telephoneNormalise String?   @map("telephone_normalise")
  source             String    @default("saisie")
  sourceRef          String?   @map("source_ref")
  creeLe             DateTime  @default(now()) @map("cree_le")
  modifieLe          DateTime  @updatedAt @map("modifie_le")
  supprimeLe         DateTime? @map("supprime_le")

  menage             Menage?   @relation(fields: [menageId], references: [id])
  donneesSensibles   DonneesSensibles?

  @@index([tenantId, nomNormalise])
  @@index([tenantId, telephoneNormalise])
  @@map("personne")
}

/// Données sociales et financières, chiffrées par l'application (AES-256-GCM).
/// La base ne voit jamais leur contenu en clair.
model DonneesSensibles {
  personneId    String   @id @map("personne_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  contenu       Bytes
  iv            Bytes
  etiquette     Bytes
  versionCle    Int      @default(1) @map("version_cle")
  modifieLe     DateTime @updatedAt @map("modifie_le")

  personne      Personne @relation(fields: [personneId], references: [id], onDelete: Cascade)

  @@map("donnees_sensibles")
}

model Document {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  organisationId   String        @map("organisation_id") @db.Uuid
  entiteType       String        @map("entite_type")
  entiteId         String        @map("entite_id") @db.Uuid
  categorie        String
  nomFichier       String        @map("nom_fichier")
  typeMime         String        @map("type_mime")
  tailleOctets     Int           @map("taille_octets")
  empreinteSha256  String        @map("empreinte_sha256")
  cleStockage      String        @unique @map("cle_stockage")
  version          Int           @default(1)
  statutAnalyse    StatutAnalyse @default(EN_ATTENTE) @map("statut_analyse")
  conserverJusquAu DateTime?     @map("conserver_jusqu_au")
  deposePar        String        @map("depose_par") @db.Uuid
  creeLe           DateTime      @default(now()) @map("cree_le")
  supprimeLe       DateTime?     @map("supprime_le")

  @@index([tenantId, entiteType, entiteId])
  @@map("document")
}

/// Journal d'audit en ajout seul : l'application ne peut ni modifier ni
/// supprimer une ligne (droits retirés dans la migration 0002).
model EvenementAudit {
  id             BigInt        @id @default(autoincrement())
  tenantId       String        @map("tenant_id") @db.Uuid
  horodatage     DateTime      @default(now())
  utilisateurId  String?       @map("utilisateur_id") @db.Uuid
  action         String
  entiteType     String        @map("entite_type")
  entiteId       String?       @map("entite_id")
  organisationId String?       @map("organisation_id") @db.Uuid
  resultat       ResultatAudit
  adresseIp      String?       @map("adresse_ip")
  details        Json?

  @@index([tenantId, horodatage])
  @@index([tenantId, entiteType, entiteId])
  @@index([tenantId, utilisateurId])
  @@map("evenement_audit")
}

// ---------------------------------------------------------------------------
// Module M1 : travaux et entretien
// ---------------------------------------------------------------------------

enum CategorieIntervention {
  PLOMBERIE
  ELECTRICITE
  GAZ
  CHAUFFAGE
  MENUISERIE
  SERRURERIE
  HUMIDITE
  NUISIBLES
  ELECTROMENAGER
  PARTIES_COMMUNES
  AUTRE
}

enum PrioriteIntervention {
  URGENTE
  HAUTE
  NORMALE
  BASSE
}

enum NatureIntervention {
  DEPANNAGE
  ENTRETIEN
  TRAVAUX
}

enum StatutIntervention {
  NOUVEAU
  QUALIFIE
  PLANIFIE
  EN_COURS
  RESOLU
  CLOS
  ANNULE
}

enum TypeLigneCout {
  DEVIS
  FACTURE
}

/// Signalement d'un problème dans un logement, suivi jusqu'à sa clôture.
model Intervention {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  organisationId      String                @map("organisation_id") @db.Uuid
  logementId          String                @map("logement_id") @db.Uuid
  categorie           CategorieIntervention
  description         String
  urgenceSignalee     Boolean               @default(false) @map("urgence_signalee")
  priorite            PrioriteIntervention?
  nature              NatureIntervention?
  statut              StatutIntervention    @default(NOUVEAU)
  affecteUtilisateurId String?              @map("affecte_utilisateur_id") @db.Uuid
  affecteArtisanId    String?               @map("affecte_artisan_id") @db.Uuid
  datePrevue          DateTime?             @map("date_prevue") @db.Date
  signalePar          String                @map("signale_par") @db.Uuid
  entretienId         String?               @map("entretien_id") @db.Uuid
  creeLe              DateTime              @default(now()) @map("cree_le")
  modifieLe           DateTime              @updatedAt @map("modifie_le")
  resoluLe            DateTime?             @map("resolu_le")
  closLe              DateTime?             @map("clos_le")

  logement            Logement              @relation(fields: [logementId], references: [id])
  affecteArtisan      Artisan?              @relation(fields: [affecteArtisanId], references: [id])
  entretien           EntretienPeriodique?  @relation(fields: [entretienId], references: [id])
  evenements          EvenementIntervention[]
  couts               LigneCout[]

  @@index([tenantId, organisationId, statut])
  @@index([tenantId, logementId])
  @@map("intervention")
}

/// Fil chronologique d'une intervention : création, qualification, affectation,
/// changements de statut, commentaires, alertes.
model EvenementIntervention {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  interventionId String       @map("intervention_id") @db.Uuid
  type           String
  auteurId       String?      @map("auteur_id") @db.Uuid
  details        Json?
  creeLe         DateTime     @default(now()) @map("cree_le")

  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([tenantId, interventionId, creeLe])
  @@map("evenement_intervention")
}

/// Devis ou facture rattaché à une intervention. Montants en centimes.
model LigneCout {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  interventionId  String        @map("intervention_id") @db.Uuid
  type            TypeLigneCout
  libelle         String
  montantCentimes Int           @map("montant_centimes")
  saisiPar        String        @map("saisi_par") @db.Uuid
  creeLe          DateTime      @default(now()) @map("cree_le")

  intervention    Intervention  @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([tenantId, interventionId])
  @@map("ligne_cout")
}

/// Carnet d'artisans d'une organisation (M1-F05).
model Artisan {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  raisonSociale  String         @map("raison_sociale")
  siret          String?
  specialites    CategorieIntervention[]
  telephone      String?
  email          String?
  actif          Boolean        @default(true)
  creeLe         DateTime       @default(now()) @map("cree_le")
  modifieLe      DateTime       @updatedAt @map("modifie_le")

  interventions  Intervention[]

  @@index([tenantId, organisationId])
  @@map("artisan")
}

/// Entretien récurrent d'un logement : chaudière, détecteurs, ramonage (M1-F07).
model EntretienPeriodique {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  organisationId      String                @map("organisation_id") @db.Uuid
  logementId          String                @map("logement_id") @db.Uuid
  libelle             String
  categorie           CategorieIntervention
  periodiciteMois     Int                   @map("periodicite_mois")
  prochaineEcheance   DateTime              @map("prochaine_echeance") @db.Date
  derniereRealisation DateTime?             @map("derniere_realisation") @db.Date
  actif               Boolean               @default(true)
  creeLe              DateTime              @default(now()) @map("cree_le")
  modifieLe           DateTime              @updatedAt @map("modifie_le")

  logement            Logement              @relation(fields: [logementId], references: [id])
  interventions       Intervention[]

  @@index([tenantId, organisationId, prochaineEcheance])
  @@map("entretien_periodique")
}

// ---------------------------------------------------------------------------
// Module M2 : coordination des bénévoles
// ---------------------------------------------------------------------------

enum TypeActivite {
  VISITE
  CHANTIER
  PERMANENCE
  REUNION
  FORMATION
  AUTRE
}

enum StatutInscription {
  INSCRIT
  LISTE_ATTENTE
  DESISTE
}

/// Profil d'un membre dans une association (M2-F01). Un même compte peut avoir
/// un profil différent dans chaque association.
model ProfilBenevole {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  utilisateurId   String    @map("utilisateur_id") @db.Uuid
  telephone       String?
  /// M2-R03 : le téléphone n'est alors visible que des coordinateurs.
  telephoneMasque Boolean   @default(false) @map("telephone_masque")
  competences     String[]
  centresInteret  String[]  @map("centres_interet")
  dateArrivee     DateTime? @map("date_arrivee") @db.Date
  modifieLe       DateTime  @updatedAt @map("modifie_le")

  @@unique([tenantId, utilisateurId])
  @@map("profil_benevole")
}

/// Disponibilité récurrente (un jour de la semaine) ou ponctuelle (une date).
model Disponibilite {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  utilisateurId String    @map("utilisateur_id") @db.Uuid
  jourSemaine   Int?      @map("jour_semaine")
  date          DateTime? @db.Date
  heureDebut    String    @map("heure_debut")
  heureFin      String    @map("heure_fin")
  commentaire   String?
  creeLe        DateTime  @default(now()) @map("cree_le")

  @@index([tenantId, utilisateurId])
  @@map("disponibilite")
}

/// Activité du groupe : visite, chantier, permanence, réunion… (M2-F03).
model Activite {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  organisationId      String        @map("organisation_id") @db.Uuid
  type                TypeActivite
  titre               String
  description         String?
  lieu                String?
  debut               DateTime
  fin                 DateTime
  /// Nombre de places ; vide = sans limite.
  places              Int?
  /// Chantier collectif lié à une intervention du module M1 (M1-F08).
  interventionId      String?       @map("intervention_id") @db.Uuid
  creePar             String        @map("cree_par") @db.Uuid
  annuleeLe           DateTime?     @map("annulee_le")
  rappelEnvoyeLe      DateTime?     @map("rappel_envoye_le")
  alerteSansInscritLe DateTime?     @map("alerte_sans_inscrit_le")
  creeLe              DateTime      @default(now()) @map("cree_le")
  modifieLe           DateTime      @updatedAt @map("modifie_le")

  inscriptions        Inscription[]

  @@index([tenantId, organisationId, debut])
  @@map("activite")
}

model Inscription {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  activiteId    String            @map("activite_id") @db.Uuid
  utilisateurId String            @map("utilisateur_id") @db.Uuid
  statut        StatutInscription
  creeLe        DateTime          @default(now()) @map("cree_le")
  modifieLe     DateTime          @updatedAt @map("modifie_le")

  activite      Activite          @relation(fields: [activiteId], references: [id], onDelete: Cascade)

  @@unique([activiteId, utilisateurId])
  @@index([tenantId, utilisateurId])
  @@map("inscription")
}

/// Bénévole référent d'un ménage (M2-F05).
model Referent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  menageId      String   @map("menage_id") @db.Uuid
  utilisateurId String   @map("utilisateur_id") @db.Uuid
  creeLe        DateTime @default(now()) @map("cree_le")

  @@unique([menageId, utilisateurId])
  @@index([tenantId, utilisateurId])
  @@map("referent")
}

// ---------------------------------------------------------------------------
// Module M3 : accueil des bénévoles
// ---------------------------------------------------------------------------

enum TypeContenuAccueil {
  ETAPE
  FICHE
  FAQ
  CONTACT
  ENGAGEMENT_CHARTE
  ENGAGEMENT_CONFIDENTIALITE
}

/// Contenu d'accueil rattaché à une organisation (M3-F02). Ceux de
/// l'association sont nationaux ; une antenne ou un groupe ajoute les siens
/// sans pouvoir modifier ceux du dessus (M3-R02).
model ContenuAccueil {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  type           TypeContenuAccueil
  titre          String
  corps          String
  lienVideo      String?            @map("lien_video")
  ordre          Int                @default(0)
  publie         Boolean            @default(true)
  creePar        String             @map("cree_par") @db.Uuid
  creeLe         DateTime           @default(now()) @map("cree_le")
  modifieLe      DateTime           @updatedAt @map("modifie_le")

  progressions   ProgressionAccueil[]

  @@index([tenantId, organisationId, type])
  @@map("contenu_accueil")
}

/// Étape du parcours terminée par une personne (M3-F01).
model ProgressionAccueil {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  utilisateurId String         @map("utilisateur_id") @db.Uuid
  contenuId     String         @map("contenu_id") @db.Uuid
  termineeLe    DateTime       @default(now()) @map("terminee_le")

  contenu       ContenuAccueil @relation(fields: [contenuId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, contenuId])
  @@index([tenantId, utilisateurId])
  @@map("progression_accueil")
}

/// Signature de la charte ou de l'engagement de confidentialité (M3-F06).
/// L'empreinte identifie le texte signé : si le texte change, il faut signer à nouveau.
model EngagementSigne {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  utilisateurId String             @map("utilisateur_id") @db.Uuid
  type          TypeContenuAccueil
  empreinte     String
  signeLe       DateTime           @default(now()) @map("signe_le")

  @@unique([tenantId, utilisateurId, type, empreinte])
  @@map("engagement_signe")
}

/// Parrain d'un nouveau bénévole (M3-F04).
model Parrainage {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  filleulId        String       @map("filleul_id") @db.Uuid
  parrainId        String       @map("parrain_id") @db.Uuid
  debut            DateTime     @default(now())
  /// Relance envoyée au parrain quand le parcours traîne (critère M3-3).
  relanceEnvoyeeLe DateTime?    @map("relance_envoyee_le")
  creePar          String       @map("cree_par") @db.Uuid

  points           PointEtape[]

  @@unique([tenantId, filleulId])
  @@map("parrainage")
}

model PointEtape {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  parrainageId String     @map("parrainage_id") @db.Uuid
  date         DateTime   @db.Date
  faitLe       DateTime?  @map("fait_le")

  parrainage   Parrainage @relation(fields: [parrainageId], references: [id], onDelete: Cascade)

  @@index([tenantId, parrainageId])
  @@map("point_etape")
}
