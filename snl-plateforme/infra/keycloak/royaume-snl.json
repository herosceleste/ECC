{
  "realm": "snl",
  "displayName": "Plateforme SNL",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "actionTokenGeneratedByAdminLifespan": 259200,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "attributes": {
    "acr.loa.map": "{\"mot-de-passe\":\"1\",\"mfa\":\"2\"}"
  },
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "ne-pas-repondre@snl.localhost",
    "fromDisplayName": "Plateforme SNL (développement)"
  },
  "clientScopes": [
    {
      "name": "snl-api-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "audience-snl-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "snl-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "snl-web",
      "name": "Interface web SNL",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": ["openid", "profile", "email", "acr", "snl-api-audience"]
    },
    {
      "clientId": "snl-api-admin",
      "name": "API SNL : gestion des comptes",
      "publicClient": false,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-snl-api-admin",
      "enabled": true,
      "serviceAccountClientId": "snl-api-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ]
}
